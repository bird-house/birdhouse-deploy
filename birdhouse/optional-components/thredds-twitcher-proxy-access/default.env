# Some old scripts and notebooks accessed threads via the twitcher proxy directly.
# In order to support this older syntax, set this value to "redirect" and the twitcher proxy route
# will be permanently redirected to the /thredds/ paths.
# In order to remove support for this older syntax and provide the user with an informative error
# message instead then set this value to "deprecate".
export THREDDS_TWITCHER_PROXY_POLICY=deprecate # possible values are "redirect" and "deprecate"
